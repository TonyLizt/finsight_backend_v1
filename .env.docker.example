# ============================================================
# Finsight Backend v1.5 - Docker Environment Example
# ============================================================
# 说明：
# 1. 本文件是 GitHub 可提交的示例配置
# 2. 本地运行时请复制为 .env.docker 后再填写真实值：
#      cp .env.docker.example .env.docker
# 3. .env.docker 必须加入 .gitignore，不要提交到 Git。
# 4. v1.5 日频与分钟级行情统一使用 Twelve Data；Alpha Vantage 主要用于新闻数据。

# ============================================================
# Database
# ============================================================
# Docker Compose 内部网络连接 MySQL。
# 注意：在 Docker Compose 内部 host 是 db，不是 localhost。
DATABASE_URL=mysql+pymysql://finsight_user:finsight_password@db:3306/finsight?charset=utf8mb4

# ============================================================
# App
# ============================================================
SECRET_KEY=change-this-secret-key-in-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PROJECT_NAME=Finsight Backend
ENVIRONMENT=docker

# 真实数据阶段建议关闭 seed，避免演示数据污染真实行情、新闻和预测结果。
# 1=启动时导入 demo seed；0=不导入。
RUN_SEED=0

# ============================================================
# Daily automatic data refresh - v1.5 Data Pipeline
# ============================================================
# 1=FastAPI 启动后开启每日自动补全任务；0=关闭。
ENABLE_DAILY_AUTO_REFRESH=1

# 每天几点执行自动补全任务，使用服务器本地时间。
DAILY_AUTO_REFRESH_HOUR=18
DAILY_AUTO_REFRESH_MINUTE=30

# 1=后端启动后立刻跑一次；0=只按每日定时执行。
# 建议保持 0，避免每次重启都消耗外部 API 额度。
DAILY_AUTO_REFRESH_RUN_ON_STARTUP=0

# 0=数据库优先，缺数据或过旧才访问外部 API；1=强制刷新。
# 不建议长期设为 1，否则容易消耗 Twelve Data / Alpha Vantage 额度。
DAILY_AUTO_REFRESH_FORCE=0

# 每日最多自动刷新多少只股票。
# 如果外部 API 额度有限，可改为 4；如果要覆盖下方 8 只核心标的，可设为 8。
DAILY_AUTO_REFRESH_LIMIT=8

# 每日自动补全股票池。
# SPY 用于回测基准；其他为核心展示与预测股票池。
DAILY_AUTO_REFRESH_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,SPY

# v1.5 每日自动补全模块。
# market        = 日频行情
# intraday      = 1min 分钟行情
# technical     = 技术指标
# news          = 新闻摘要与情绪
# news_fulltext = 新闻正文抓取
# sentiment     = 新闻情绪聚合
# features      = 模型特征快照
DAILY_AUTO_REFRESH_MODULES=market,intraday,technical,news,news_fulltext,sentiment,features

# 新闻情绪窗口天数。
DAILY_AUTO_REFRESH_NEWS_WINDOW_DAYS=14

# ============================================================
# Prediction on-demand pipeline
# ============================================================
# 1=预测前自动补齐需要的数据；0=只使用数据库现有数据。
PREDICTION_ON_DEMAND_PIPELINE=1
PREDICTION_ON_DEMAND_MODULES=market,technical,news,sentiment,features
PREDICTION_ON_DEMAND_ALLOW_FALLBACK=1

# ============================================================
# Core tickers and on-demand ingest
# ============================================================
FINSIGHT_CORE_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META
FINSIGHT_ENABLE_ON_DEMAND_INGEST=true

# ============================================================
# Twelve Data - market and intraday data
# ============================================================
# GitHub 示例文件不要写真实 API Key。
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_BASE_URL=https://api.twelvedata.com
TWELVEDATA_TIMEZONE=America/New_York
TWELVEDATA_DAILY_INTERVAL=1day
TWELVEDATA_INTRADAY_INTERVAL=1min
TWELVEDATA_DAILY_OUTPUTSIZE=5000
TWELVEDATA_INTRADAY_OUTPUTSIZE=5000
TWELVEDATA_INTRADAY_PREPOST=false
TWELVEDATA_TIMEOUT_SECONDS=30

# 请求间隔，避免触发外部 API 频率限制。
TWELVEDATA_REQUEST_SLEEP_SECONDS=8

# 首次补齐历史范围。
TWELVEDATA_DAILY_INITIAL_BACKFILL_DAYS=1260
TWELVEDATA_INTRADAY_INITIAL_BACKFILL_DAYS=7

# ============================================================
# Alpha Vantage - news data
# ============================================================
# GitHub 示例文件不要写真实 API Key。
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# 新闻抓取参数。
NEWS_FETCH_LOOKBACK_DAYS=30
NEWS_FETCH_LIMIT=1000
NEWS_FETCH_TIMEOUT_SECONDS=30

# ============================================================
# News detail content fetch
# ============================================================
ENABLE_NEWS_DETAIL_FETCH=1
NEWS_DETAIL_FETCH_TIMEOUT_SECONDS=10
NEWS_DETAIL_MIN_TEXT_CHARS=200
NEWS_DETAIL_MAX_TEXT_CHARS=12000
NEWS_DETAIL_MAX_HTML_CHARS=200000

# 0=只保存正文纯文本；1=同时保存 HTML。
# 建议保持 0，避免数据库体积过大。
NEWS_DETAIL_STORE_HTML=0

# ============================================================
# Bailian / DashScope LLM report
# ============================================================
# GitHub 示例文件不要写真实 API Key 和真实 App ID。
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# true=启用百炼报告；false=使用模板降级报告。
BAILIAN_ENABLE=true
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_NEWS_APP_ID=your_bailian_news_app_id_here
BAILIAN_REPORT_APP_ID=your_bailian_report_app_id_here

# 默认业务空间可以留空；子业务空间才需要填写。
BAILIAN_WORKSPACE_ID=
BAILIAN_TIMEOUT_SECONDS=45

# ============================================================
# Legacy / fallback market config
# ============================================================
# v1.5 日频行情已统一使用 Twelve Data。
# 以下变量主要用于兼容旧逻辑或保留 fallback 配置。
MARKET_DATA_SOURCE_PRIORITY=twelvedata,yahoo_chart,local_raw_csv
ENABLE_YAHOO_CHART_FALLBACK=1

# 0=不依赖本地 raw CSV；1=线上源失败时允许使用本地 raw CSV 作为 fallback。
# GitHub 示例建议保持 0，因为仓库通常不包含本地数据集。
ENABLE_LOCAL_RAW_CSV_FALLBACK=0

# 本地 raw CSV 备用路径。ENABLE_LOCAL_RAW_CSV_FALLBACK=0 时不会使用。
MARKET_DATA_LOCAL_RAW_ROOT=/external_datasets/market_data/backtest_market_raw_20250521_20260531

# 行情补全策略。
MARKET_DATA_MIN_HISTORY_DAYS=252
MARKET_DATA_MAX_STALE_DAYS=5
MARKET_DATA_GAP_LOOKBACK_DAYS=90
MARKET_DATA_GAP_TRIGGER_COUNT=3
MARKET_DATA_TIMEOUT_SECONDS=30

# 异常价格检测。
# 0.35 表示价格偏离邻域中位数 35% 以上判为 suspicious。
PRICE_SUSPICIOUS_CHANGE_THRESHOLD=0.35
PRICE_QUALITY_LOOKBACK_DAYS=120

# Yahoo Chart 请求 UA，保留给旧 fallback 逻辑。
MARKET_DATA_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
